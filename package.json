{
  "name": "nextjs-boilerplate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "new": "node scripts/new-project.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck",
    "build:vercel": "next build",
    "build:node": "DEPLOY_TARGET=node next build && node scripts/package-node.mjs",
    "build:static": "DEPLOY_TARGET=static next build && node scripts/package-static.mjs",
    "preview:static": "php -S localhost:8080 -t out php/dev-router.php"
  },
  "dependencies": {
    "next": "16.3.8",
    "nodemailer": "^10.0.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}

# ---- Build target ----
# Set automatically by npm run build:vercel / build:node / build:static. Leave unset for dev and Vercel.
# DEPLOY_TARGET=vercel

# ---- Site ----
# Canonical origin, no trailing slash. Used for metadataBase, canonicals, sitemap, JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# production | staging | development. Anything but "production" is noindexed and robots.txt disallows all.
NEXT_PUBLIC_SITE_ENV=development
# "true" shows content the client still has to supply (anything wrapped in <Pending>).
# Leave unset in production so placeholders stay hidden. See src/components/ui/Pending.tsx.
NEXT_PUBLIC_SHOW_PENDING=

# ---- Forms: email (SMTP) ----
# Leave SMTP_HOST empty to skip email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FORM_FROM_EMAIL="Website <no-reply@example.com>"
# Comma-separated for multiple recipients.
FORM_TO_EMAIL=

# ---- Forms: webhook (GoHighLevel / Zapier / Make / n8n) ----
# Leave empty to skip. Both channels can run together; a submission succeeds if either delivers.
FORM_WEBHOOK_URL=
FORM_WEBHOOK_SECRET=

# ---- Forms: Cloudflare Turnstile (optional) ----
# Set both to enable. Leave empty to rely on honeypot + timing + rate limit only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

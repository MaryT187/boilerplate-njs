{
  "$comment": "Single source of truth for every form. Read by the Next.js route (zod) AND the PHP handler, so rules stay identical on every host. Field types: text, email, tel, textarea, select, checkbox.",
  "contact": {
    "subject": "New enquiry from {name}",
    "redirect": "/thank-you",
    "fields": {
      "name": { "label": "Name", "type": "text", "required": true, "min": 2, "max": 100, "message": "Enter your name" },
      "email": {
        "label": "Email",
        "type": "email",
        "required": true,
        "max": 200,
        "message": "Enter a valid email address"
      },
      "phone": { "label": "Phone", "type": "tel", "max": 20, "message": "Enter a valid phone number" },
      "service": { "label": "Service", "type": "select", "max": 100 },
      "message": {
        "label": "Message",
        "type": "textarea",
        "required": true,
        "min": 10,
        "max": 5000,
        "message": "Tell us a little more (10+ characters)"
      }
    }
  }
}
